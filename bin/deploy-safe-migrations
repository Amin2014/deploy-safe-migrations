#!/usr/bin/env php
<?php

declare(strict_types=1);

$autoload = $GLOBALS['_composer_autoload_path'] ?? __DIR__.'/../vendor/autoload.php';
if (!is_file($autoload)) {
    fwrite(STDERR, "Install dependencies with composer install first.\n");
    exit(2);
}
require $autoload;
exit((new DeploySafe\Cli())->run(array_slice($argv, 1)));
